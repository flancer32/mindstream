{
  "name": "@flancer32/mindstream",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "types": "types.d.ts",
  "license": "Apache-2.0",
  "teqfw": {
    "namespaces": [
      {
        "prefix": "Mindstream_Back_",
        "path": "./src",
        "ext": ".mjs"
      },
      {
        "prefix": "Mindstream_Web_",
        "path": "./web/app/Web",
        "ext": ".mjs"
      },
      {
        "prefix": "Mindstream_Shared_",
        "path": "./web/app/Shared",
        "ext": ".mjs"
      }
    ]
  },
  "bin": {
    "mindstream": "./bin/cli.mjs"
  },
  "scripts": {
    "start": "node ./bin/cli.mjs runtime:web",
    "test:unit": "node --test \"test/unit/**/*.test.mjs\""
  },
  "dependencies": {
    "@flancer32/teq-web": "github:flancer32/teq-web#main",
    "@teqfw/cfg": "github:teqfw/cfg#main",
    "@teqfw/di": "github:teqfw/di#main",
    "@teqfw/log": "^0.1.0",
    "knex": "^3.2.10",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2"
  }
}
