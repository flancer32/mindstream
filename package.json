{
  "name": "@flancer32/mindstream",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "types": "types.d.ts",
  "license": "Apache-2.0",
  "teqfw": {
    "fw": {
      "di": {
        "namespaces": [
          {
            "prefix": "Mindstream_Back_",
            "path": "./src",
            "ext": ".mjs"
          },
          {
            "prefix": "Mindstream_Web_",
            "path": "./web/app/Web",
            "ext": ".mjs"
          },
          {
            "prefix": "Mindstream_Shared_",
            "path": "./web/app/Shared",
            "ext": ".mjs"
          }
        ]
      },
      "cli": {
        "plugin": "Mindstream_Back_App_Plugin$",
        "command": {
          "default": "web:start"
        },
        "commands": [
          {
            "id": "ingest:import",
            "summary": "Import one prepared publication from a local JSON file.",
            "arguments": [
              {
                "name": "file",
                "kind": "string",
                "required": true,
                "description": "Publication JSON file."
              }
            ],
            "options": [],
            "component": "Mindstream_Back_Cli_Ingest_Import$"
          },
          {
            "id": "db:schema:migrate-legacy-to-dem-rdb",
            "summary": "Copy legacy PostgreSQL data into an initialized DEM-RDB target schema.",
            "arguments": [],
            "options": [
              {
                "name": "source-schema",
                "kind": "string",
                "required": false,
                "description": "Legacy PostgreSQL schema. Defaults to public."
              }
            ],
            "component": "Mindstream_Back_Cli_Db_Schema_MigrateV2$"
          },
          {
            "id": "ingest:discover:habr",
            "summary": "Discover Habr publications through RSS.",
            "arguments": [],
            "options": [],
            "component": "Mindstream_Back_Cli_Ingest_Discover_Habr$"
          },
          {
            "id": "ingest:extract:habr",
            "summary": "Extract Habr publication text.",
            "arguments": [],
            "options": [],
            "component": "Mindstream_Back_Cli_Ingest_Extract_Habr$"
          },
          {
            "id": "process:generate:embeddings",
            "summary": "Generate publication embeddings.",
            "arguments": [],
            "options": [],
            "component": "Mindstream_Back_Cli_Process_Generate_Embeddings$"
          },
          {
            "id": "process:generate:summaries",
            "summary": "Generate publication summaries.",
            "arguments": [],
            "options": [],
            "component": "Mindstream_Back_Cli_Process_Generate_Summaries$"
          }
        ]
      }
    }
  },
  "scripts": {
    "db:migrate-legacy": "teq db:schema:migrate-legacy-to-dem-rdb",
    "start": "teq web:start",
    "test:unit": "node --test \"test/unit/**/*.test.mjs\"",
    "test:postgresql:dem": "node --test test/optin/DemPostgresql.test.mjs"
  },
  "dependencies": {
    "@teqfw/cfg": ">=2.1.0 <3",
    "@teqfw/cli": ">=2.2.0 <3",
    "@teqfw/dem": ">=2.1.0 <3",
    "@teqfw/dem-rdb": ">=2.1.0 <3",
    "@teqfw/di": "^2.12.1",
    "@teqfw/log": ">=2.1.2 <3",
    "@teqfw/web": ">=2.0.0 <3",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2"
  }
}
